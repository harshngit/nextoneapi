# ─── Firebase FCM Push Notifications ────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key (downloads a JSON file)
#
# Copy the values from the downloaded JSON into these three variables:

FCM_PROJECT_ID=nextone-70b85
FCM_CLIENT_EMAIL=firebase-adminsdk-XXXX@nextone-70b85.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"
# ↑ Keep the quotes. Replace \n with actual newline characters if your host
#   does not support escape sequences in .env files.
